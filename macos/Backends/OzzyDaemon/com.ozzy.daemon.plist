<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ozzy.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/OzzyDaemon</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- The clients' calls (macos/Shared/ozzy_daemon.h) -->
	<key>MachServices</key>
	<dict>
		<key>com.ozzy.daemon</key>
		<true/>
	</dict>
	<!-- Audio: no throttling as a background job -->
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
