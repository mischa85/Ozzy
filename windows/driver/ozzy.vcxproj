<?xml version="1.0" encoding="utf-8"?>
<!-- Ozzy ACX driver (ozzy.sys). Build: msbuild ozzy.vcxproj /p:Configuration=Release /p:Platform=x64
     The package lands in windows\build\x64\Release\ozzy\ (ozzy.inf, ozzy.sys, ozzy.cat). -->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The WDK from NuGet (scripts\wdk.ps1 fetches it into windows\build\wdk\): no WDK or EWDK install
       needed, only the MSVC build tools. Without it, the WDK of the environment (EWDK, VS + WDK). -->
  <PropertyGroup>
    <OzzyWdkDir Condition="'$(OzzyWdkDir)' == ''">$(MSBuildThisFileDirectory)..\build\wdk\</OzzyWdkDir>
    <OzzyWdkNuGet Condition="Exists('$(OzzyWdkDir)Microsoft.Windows.WDK.x64\build\native\Microsoft.Windows.WDK.x64.props')">true</OzzyWdkNuGet>
  </PropertyGroup>
  <ImportGroup Condition="'$(OzzyWdkNuGet)' == 'true'">
    <Import Project="$(OzzyWdkDir)Microsoft.Windows.SDK.CPP\build\native\Microsoft.Windows.SDK.cpp.props" />
    <Import Project="$(OzzyWdkDir)Microsoft.Windows.SDK.CPP.x64\build\native\Microsoft.Windows.SDK.cpp.x64.props" />
    <Import Project="$(OzzyWdkDir)Microsoft.Windows.WDK.x64\build\native\Microsoft.Windows.WDK.x64.props" />
  </ImportGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{C20E620F-9778-4BB6-B417-1F747BC4B11C}</ProjectGuid>
    <TemplateGuid>{497e31cb-056b-4f31-abb8-447fd55ee5a5}</TemplateGuid>
    <RootNamespace>Ozzy</RootNamespace>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>31</KMDF_VERSION_MINOR>
    <ACX_VERSION_MAJOR>1</ACX_VERSION_MAJOR>
    <ACX_VERSION_MINOR>1</ACX_VERSION_MINOR>
  </PropertyGroup>
  <!-- Devices to leave out (keys from common/ozzy_devices.def, separated by spaces or commas):
       /p:OzzyDisable="TascamUS144 NumarkNS7", or the OZZY_DISABLE environment variable. Left out of
       the INF (GenInf) and of the driver's device table, like -DOZZY_DISABLE_<key> on Linux and macOS. -->
  <PropertyGroup>
    <OzzyDisable Condition="'$(OzzyDisable)' == ''">$(OZZY_DISABLE)</OzzyDisable>
    <OzzyDisableKeys>$([System.Text.RegularExpressions.Regex]::Replace('$(OzzyDisable.Trim())', '[\s,;]+', ';'))</OzzyDisableKeys>
    <OzzyDisableDefines Condition="'$(OzzyDisableKeys)' != ''">OZZY_DISABLE_$(OzzyDisableKeys.Replace(';', ';OZZY_DISABLE_'))</OzzyDisableDefines>
    <OzzyDisableFlags Condition="'$(OzzyDisableKeys)' != ''">/DOZZY_DISABLE_$(OzzyDisableKeys.Replace(';', ' /DOZZY_DISABLE_'))</OzzyDisableFlags>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>ozzy</TargetName>
    <OutDir>$(MSBuildThisFileDirectory)..\build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\build\obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)kcrt;$(DDK_INC_PATH)\acx\km\$(ACX_VERSION_MAJOR).$(ACX_VERSION_MINOR);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>$(OzzyDisableDefines);ACX_VERSION_MAJOR=$(ACX_VERSION_MAJOR);ACX_VERSION_MINOR=$(ACX_VERSION_MINOR);KMDF_VERSION_MAJOR=$(KMDF_VERSION_MAJOR);KMDF_VERSION_MINOR=$(KMDF_VERSION_MINOR);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(DDK_LIB_PATH)\libcntpr.lib;$(DDK_LIB_PATH)\ksguid.lib;acx\km\$(ACX_VERSION_MAJOR).$(ACX_VERSION_MINOR)\acxstub.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="device.c" />
    <ClCompile Include="circuit.c" />
    <ClCompile Include="stream.c" />
    <ClCompile Include="kmdf_bus.c" />
    <ClCompile Include="settings.c" />
    <ClCompile Include="midi.c" />
    <ClCompile Include="..\..\engine\core\ozzy_engine.c" />
    <ClCompile Include="..\..\engine\core\ozzy_isoc_output.c" />
    <ClCompile Include="..\..\engine\devices\ploytec\ploytec_engine.c" />
    <ClCompile Include="..\..\engine\devices\ploytec\ploytec_io.c" />
    <ClCompile Include="..\..\engine\devices\ploytec\ploytec_isoc_engine.c" />
    <ClCompile Include="..\..\engine\devices\usbmidi\usb_midi_engine.c" />
    <ClCompile Include="..\..\common\devices\ploytec\ploytec_handshake.c" />
    <ClCompile Include="..\..\common\devices\ploytec\ploytec_codec.c" />
    <ClCompile Include="..\..\common\usb_midi.c" />
    <ClCompile Include="..\..\common\midi_ump.c" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated before the build from ozzy.inf.in (OzzyGenerateInf) -->
    <Inf Include="$(IntDir)ozzy.inf" />
  </ItemGroup>
  <ItemGroup>
    <!-- The driver next to the INF in the package (windows\build\x64\Release\ozzy\), where inf2cat and pnputil look -->
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Condition="'$(OzzyWdkNuGet)' == 'true'">
    <Import Project="$(OzzyWdkDir)Microsoft.Windows.SDK.CPP\build\native\Microsoft.Windows.SDK.cpp.targets" />
  </ImportGroup>
  <!-- The commit for the driver's record and log (common/ozzy_version.h): git describe, or
       /p:OzzyGitVersion=... (a build from a copy without .git says "unknown") -->
  <Target Name="OzzyGitVersion" BeforeTargets="ClCompile">
    <Exec Command="git -C &quot;$(MSBuildThisFileDirectory)..&quot; describe --always --dirty" Condition="'$(OzzyGitVersion)' == ''"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="OzzyGitVersion" />
      <Output TaskParameter="ExitCode" PropertyName="OzzyGitExit" />
    </Exec>
    <PropertyGroup>
      <OzzyGitVersion Condition="'$(OzzyGitExit)' != '' and '$(OzzyGitExit)' != '0'"></OzzyGitVersion>
    </PropertyGroup>
    <!-- A header the compiler force-includes: a quoted string doesn't survive PreprocessorDefinitions -->
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(IntDir)ozzy_git_version.h" Lines="#define OZZY_GIT_VERSION &quot;$(OzzyGitVersion)&quot;" Overwrite="true"
                      WriteOnlyWhenDifferent="true" Condition="'$(OzzyGitVersion)' != ''" />
    <ItemGroup Condition="'$(OzzyGitVersion)' != ''">
      <ClCompile>
        <ForcedIncludeFiles>$(IntDir)ozzy_git_version.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      </ClCompile>
    </ItemGroup>
  </Target>
  <!-- ozzy.inf: the template with one model line per supported device in common/ozzy_devices.def.
       GenInf.c is compiled for the host with the build's own MSVC and SDK (the UCRT), so this works
       with the NuGet WDK, the EWDK and Visual Studio alike, without a developer prompt. -->
  <!-- The devices left out, as a file that changes with them, so the INF is made again -->
  <Target Name="OzzyDisableStamp" BeforeTargets="OzzyGenerateInf">
    <MakeDir Directories="$(IntDir)GenInf" />
    <WriteLinesToFile File="$(IntDir)GenInf\disabled.txt" Lines="$(OzzyDisableKeys)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="OzzyGenerateInf" BeforeTargets="PrepareForBuild"
          Inputs="..\inf\ozzy.inf.in;..\inf\GenInf.c;..\..\common\ozzy_devices.def;..\..\common\ozzy_devices.h;$(IntDir)GenInf\disabled.txt" Outputs="$(IntDir)ozzy.inf">
    <Exec Command="set &quot;INCLUDE=$(VCToolsInstallDir)include;$(UniversalCRT_IncludePath)&quot; &amp;&amp; set &quot;LIB=$(VC_LibraryPath_VC_x64_Desktop);$(UniversalCRT_LibraryPath_x64);$(WindowsSDK_LibraryPath_x64)&quot; &amp;&amp; &quot;$(VC_ExecutablePath_x64_x64)\cl.exe&quot; /nologo /W3 /MT $(OzzyDisableFlags) /Fo&quot;$(IntDir)GenInf\\&quot; /Fe&quot;$(IntDir)GenInf\GenInf.exe&quot; &quot;$(MSBuildThisFileDirectory)..\inf\GenInf.c&quot; &gt;nul &amp;&amp; &quot;$(IntDir)GenInf\GenInf.exe&quot; &quot;$(MSBuildThisFileDirectory)..\inf\ozzy.inf.in&quot; &gt; &quot;$(IntDir)ozzy.inf&quot;" />
  </Target>
</Project>
