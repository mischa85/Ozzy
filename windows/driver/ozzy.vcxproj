<?xml version="1.0" encoding="utf-8"?>
<!-- Ozzy ACX driver (ozzy.sys). Build: msbuild ozzy.vcxproj /p:Configuration=Release /p:Platform=x64 -->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{C20E620F-9778-4BB6-B417-1F747BC4B11C}</ProjectGuid>
    <TemplateGuid>{497e31cb-056b-4f31-abb8-447fd55ee5a5}</TemplateGuid>
    <RootNamespace>Ozzy</RootNamespace>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>31</KMDF_VERSION_MINOR>
    <ACX_VERSION_MAJOR>1</ACX_VERSION_MAJOR>
    <ACX_VERSION_MINOR>1</ACX_VERSION_MINOR>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>ozzy</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(DDK_INC_PATH)\acx\km\$(ACX_VERSION_MAJOR).$(ACX_VERSION_MINOR);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>ACX_VERSION_MAJOR=$(ACX_VERSION_MAJOR);ACX_VERSION_MINOR=$(ACX_VERSION_MINOR);KMDF_VERSION_MAJOR=$(KMDF_VERSION_MAJOR);KMDF_VERSION_MINOR=$(KMDF_VERSION_MINOR);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(DDK_LIB_PATH)\libcntpr.lib;acx\km\$(ACX_VERSION_MAJOR).$(ACX_VERSION_MINOR)\acxstub.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Driver.cpp" />
    <ClCompile Include="Device.cpp" />
    <ClCompile Include="Circuit.cpp" />
    <ClCompile Include="Stream.cpp" />
    <ClCompile Include="KmdfBus.cpp" />
    <ClCompile Include="KernelNew.cpp" />
    <ClCompile Include="..\..\engine\core\ozzy_engine.c" />
    <ClCompile Include="..\..\engine\core\ozzy_isoc_output.c" />
    <ClCompile Include="..\..\engine\devices\ploytec\ploytec_engine.c" />
    <ClCompile Include="..\..\engine\devices\ploytec\ploytec_isoc_engine.c" />
    <ClCompile Include="..\..\engine\devices\usbmidi\usb_midi_engine.c" />
    <ClCompile Include="..\..\common\devices\ploytec\ploytec_handshake.c" />
    <ClCompile Include="..\..\common\devices\ploytec\ploytec_codec.c" />
    <ClCompile Include="..\..\common\usb_midi.c" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated before the build from ozzy.inf.in (OzzyGenerateInf) -->
    <Inf Include="$(IntDir)ozzy.inf" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- ozzy.inf: the template with one model line per supported device in common/ozzy_devices.def.
       GenInf.c is compiled for the host with the Visual Studio install's own compiler (vcvarsall),
       so this works from the IDE as well as a developer prompt. -->
  <Target Name="OzzyGenerateInf" BeforeTargets="PrepareForBuild"
          Inputs="ozzy.inf.in;GenInf.c;..\..\common\ozzy_devices.def;..\..\common\ozzy_devices.h" Outputs="$(IntDir)ozzy.inf">
    <MakeDir Directories="$(IntDir)GenInf" />
    <Exec Command="call &quot;$(VSInstallDir)VC\Auxiliary\Build\vcvarsall.bat&quot; %PROCESSOR_ARCHITECTURE% &gt;nul &amp;&amp; cl /nologo /W3 /Fo&quot;$(IntDir)GenInf\\&quot; /Fe&quot;$(IntDir)GenInf\GenInf.exe&quot; &quot;$(MSBuildThisFileDirectory)GenInf.c&quot; &gt;nul &amp;&amp; &quot;$(IntDir)GenInf\GenInf.exe&quot; &quot;$(MSBuildThisFileDirectory)ozzy.inf.in&quot; &gt; &quot;$(IntDir)ozzy.inf&quot;" />
  </Target>
</Project>
